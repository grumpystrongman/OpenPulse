COMPOSE_PROJECT_NAME=openpulse
OPENPULSE_ENV=dev
OPENPULSE_LOG_LEVEL=INFO

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_RAW_TOPIC=openpulse.raw.ingest
KAFKA_NORMALIZED_TOPIC=openpulse.normalized.observation

CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=openpulse

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=openpulse
MINIO_SECRET_KEY=openpulse123
MINIO_BUCKET_BRONZE=openpulse-bronze
MINIO_SECURE=false

REDIS_HOST=redis
REDIS_PORT=6379

PSEUDONYMIZATION_SALT=openpulse-dev-salt

GOVERNOR_POLICY_PATH=/app/services/governance-agent/app/policy/default_policy.yaml
