            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/simulate/{manufacturer}": {
      "post": {
        "summary": "Simulate",
        "operationId": "simulate_v1_simulate__manufacturer__post",
        "parameters": [
          {
            "name": "manufacturer",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Manufacturer"
            }
          },
          {
            "name": "subjects",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 2,
              "title": "Subjects"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "default": 2,
              "title": "Days"
            }
          },
          {
            "name": "profile",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(healthy|athletic|at_risk|chronic)$",
              "default": "healthy",
              "title": "Profile"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Simulate V1 Simulate  Manufacturer  Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/simulate-all": {
      "post": {
        "summary": "Simulate All",
        "operationId": "simulate_all_v1_simulate_all_post",
        "parameters": [
          {
            "name": "subjects",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "default": 2,
              "title": "Subjects"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 365,
              "minimum": 1,
              "default": 2,
              "title": "Days"
            }
          },
          {
            "name": "profile",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(healthy|athletic|at_risk|chronic)$",
              "default": "healthy",
              "title": "Profile"
            }
          }
