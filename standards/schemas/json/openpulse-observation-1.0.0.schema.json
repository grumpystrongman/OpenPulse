{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openpulse.dev/schema/observation/1.0.0",
  "title": "OpenPulse Canonical Observation",
  "type": "object",
  "required": [
    "observation_id",
    "subject_id",
    "manufacturer",
    "metric_code",
    "metric_display",
    "quality_score",
    "completeness_score",
    "confidence_score",
    "clinical_grade",
    "event_time"
  ],
  "properties": {
    "observation_id": { "type": "string" },
    "subject_id": { "type": "string" },
    "manufacturer": { "type": "string" },
    "metric_code": { "type": "string" },
    "metric_display": { "type": "string" },
    "value": { "type": ["number", "null"] },
    "value_text": { "type": ["string", "null"] },
    "unit": { "type": ["string", "null"] },
    "original_value": { "type": ["number", "null"] },
    "original_unit": { "type": ["string", "null"] },
    "quality_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "completeness_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "confidence_score": { "type": "number", "minimum": 0, "maximum": 1 },
    "clinical_grade": { "type": "string", "enum": ["consumer", "clinical"] },
    "event_time": { "type": "string", "format": "date-time" },
    "observed_time": { "type": ["string", "null"], "format": "date-time" },
    "device_time": { "type": ["string", "null"], "format": "date-time" },
    "received_time": { "type": ["string", "null"], "format": "date-time" },
    "processed_time": { "type": ["string", "null"], "format": "date-time" },
    "session_id": { "type": ["string", "null"] },
    "extension_namespace": { "type": ["string", "null"] },
    "extension_payload": { "type": ["object", "null"] }
  }
}
